# Copy to .env.production on the deployment host, never commit the filled file.
QASE_PROVIDER=custom
QASE_BASE_URL=https://llm.drytis.ai/v1
QASE_MODEL=drytis/claude-opus-4.7
QASE_API_KEY=REPLACE_IN_SECRET_MANAGER
QASE_HEADLESS=true
# Enable only after target-image qualification with this account's gateway key.
# Never copy developer .qase state or qualification receipts into production.
QASE_HYBRID_QA_ENABLED=false
QASE_HYBRID_ALLOW_WITHOUT_JEV=false
# Default receipts live in the persistent /app/.qase volume and expire in 24h.
# Renew with an approved operator job; API and workers need the same receipt.
# QASE_HYBRID_QUALIFICATION_FILE=/app/.qase/qualifications/hybrid/PROFILE.json
QASE_MAX_TURNS=120
QASE_SQA_BROWSER_TOOL_BUDGET=120
QASE_SECURITY_PAYLOAD_LIMIT=40
QASE_BROWSER_ALLOWED_ORIGINS=
# SMTP must be configured and tested for production password recovery.
QASE_MAIL_MODE=smtp
QASE_MAIL_SENDER=primary
QASE_MAIL_HOST=REPLACE_WITH_SMTP_HOST
QASE_MAIL_PORT=587
QASE_MAIL_USER=REPLACE_WITH_SMTP_USER
QASE_MAIL_PASSWORD=REPLACE_IN_SECRET_MANAGER
QASE_MAIL_FROM=QASE <no-reply@drytis.com>
# Set distinct real UUIDs and approved operator identity before first boot.
QASE_BOOTSTRAP_ORGANIZATION_ID=REPLACE_WITH_UUID
QASE_BOOTSTRAP_PROJECT_ID=REPLACE_WITH_DIFFERENT_UUID
QASE_BOOTSTRAP_USER_ID=REPLACE_WITH_DIFFERENT_UUID
QASE_BOOTSTRAP_USER_EMAIL=REPLACE_WITH_OPERATOR_EMAIL
QASE_BOOTSTRAP_USER_NAME=QASE Operator
QASE_LOG_FORMAT=json
QASE_LOG_LEVEL=info
