{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/qase/resilience-evidence-v1.json",
  "title": "Qase resilience drill evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "drill", "targetAlias", "releaseId", "startedAt",
    "durationSeconds", "detectionSeconds", "recoverySeconds", "dataLossCount",
    "crossTenantViolationCount", "failedClosed", "correlationIds", "operatorApproved"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "drill": {
      "enum": [
        "api-replica-loss", "worker-lease-expiry", "redis-interruption",
        "database-failover", "heartbeat-outage", "control-replica-loss",
        "isolated-backup-restore"
      ]
    },
    "targetAlias": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "releaseId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$", "not": { "pattern": "://" } },
    "startedAt": { "type": "string", "format": "date-time" },
    "durationSeconds": { "type": "number", "minimum": 0, "maximum": 86400 },
    "detectionSeconds": { "type": "number", "minimum": 0, "maximum": 86400 },
    "recoverySeconds": { "type": "number", "minimum": 0, "maximum": 86400 },
    "dataLossCount": { "type": "integer", "const": 0 },
    "crossTenantViolationCount": { "type": "integer", "const": 0 },
    "failedClosed": { "const": true },
    "correlationIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "operatorApproved": { "const": true }
  }
}
