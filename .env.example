# ── Model ────────────────────────────────────────────────────────────
# Everything here can also be set in the dashboard under Settings, which
# writes .qase/config.json and takes precedence over this file.

# custom | anthropic | openai | azureOpenAI | gemini | grok | nvidia |
# openrouter | bedrock
QASE_PROVIDER=custom

# Your key.
QASE_API_KEY=sk-...

# For provider=custom this is required: the root of your OpenAI-compatible
# endpoint, the part before /chat/completions. Include /v1 if yours expects it.
QASE_BASE_URL=https://your-endpoint.example.com/v1

# Exactly the model id your endpoint expects.
QASE_MODEL=your-model-id

# low | medium | high — how much the model thinks before acting.
QASE_REASONING=medium

# Hard ceiling on agent turns per run, so a stuck loop cannot run forever.
QASE_MAX_TURNS=120

# ── Browser ──────────────────────────────────────────────────────────
# true keeps Chromium off-screen and streams it to the dashboard (recommended).
# false also opens a real Chrome window on your desktop.
QASE_HEADLESS=true

# Live view tuning. Lower interval = smoother, more CPU.
QASE_FRAME_INTERVAL_MS=320
QASE_FRAME_QUALITY=55

# How long the cursor is shown travelling to its target before the agent acts.
# This is deliberate latency so the run is watchable. 0 disables the pause.
QASE_CURSOR_DWELL_MS=420

# How long a click waits for a client-side router before its URL is reported.
QASE_NAV_SETTLE_MS=1600

# Close a session's browser after this many ms of no activity. 0 (the default)
# keeps it open for the whole session. Cookies and the current page are restored
# either way, so this only affects how long Chromium stays resident.
QASE_BROWSER_IDLE_MS=0

# ── Server ───────────────────────────────────────────────────────────
# Loopback-only by default. Set deliberately when deploying behind a trusted proxy.
QASE_HOST=127.0.0.1
PORT=5173

# ── Run persistence ──────────────────────────────────────────────────
# local remains the rollback-safe default during Phase 2. postgres is an
# explicit opt-in and never silently falls back to local JSON on failure.
QASE_RUN_STORE=local

# Required only when QASE_RUN_STORE=postgres. Prefer a dedicated, non-owner,
# non-superuser application role without BYPASSRLS.
# QASE_DATABASE_URL=postgresql://qase_app:password@db.example.com:5432/qase
# Optional separate owner/DDL credential used only by `npm run db:migrate`.
# QASE_MIGRATION_DATABASE_URL=postgresql://qase_migrator:password@db.example.com:5432/qase
# disable | require | no-verify. Production defaults to require.
QASE_DATABASE_SSL=disable
QASE_DATABASE_POOL_MIN=0
QASE_DATABASE_POOL_MAX=20
# Development defaults to true. Production defaults to false so a dedicated
# deployment job can run `npm run db:migrate` with separate DDL credentials.
QASE_DATABASE_MIGRATE_ON_START=true
# Development defaults to true for compatibility. Production defaults to false
# so one API replica cannot interrupt a run owned by another replica. Enable
# once during a controlled single-owner recovery after a crashed execution host.
QASE_POSTGRES_RECOVER_ACTIVE_RUNS=true

# ── Distributed execution (Phase 4) ─────────────────────────────────
# local runs the agent in the API process. distributed keeps the API stateless
# and requires PostgreSQL, Redis, and one or more `npm run worker` processes.
QASE_EXECUTION_MODE=local
# Required for distributed mode. Production requires TLS (`rediss://`).
# QASE_REDIS_URL=rediss://qase:password@redis.example.com:6380
# Required in distributed mode: base64url encoding of exactly 32 random bytes.
# Generate outside source control, place in your secrets manager, and mount the
# same value into API and worker processes.
# QASE_SECRETS_MASTER_KEY=replace-with-43-character-base64url-value
QASE_SECRETS_TTL_SECONDS=3600
QASE_WORKER_LEASE_MS=30000
QASE_WORKER_POLL_MS=1000
QASE_JOB_MAX_ATTEMPTS=3
QASE_JOB_RETENTION_DAYS=30
# Cell-wide durable admission limit across every API replica.
QASE_QUEUE_MAX_ACTIVE_JOBS=5000
# Optional stable pod/host identity; defaults to hostname:process-id.
# QASE_WORKER_ID=qase-worker-zone-a-001

# ── Operations and telemetry (Phase 5) ──────────────────────────────
# Per-API-replica cap for concurrent POST/PUT/PATCH/DELETE requests.
QASE_MUTATION_MAX_IN_FLIGHT=64
# Metrics are disabled unless this is set to a random value of at least 32 bytes.
# Scrapers send: Authorization: Bearer <token>
# QASE_METRICS_TOKEN=replace-with-a-long-random-metrics-token
# Worker liveness/readiness/metrics listener. Keep loopback unless a private
# orchestrator network needs to scrape it.
QASE_WORKER_PROBE_HOST=127.0.0.1
QASE_WORKER_PROBE_PORT=9174
# Structured stdout logs. Production defaults to json/info automatically.
QASE_LOG_FORMAT=json
QASE_LOG_LEVEL=info

# ── Global control plane (Phase 6, separate process/database) ───────
# QASE_CONTROL_DATABASE_URL=postgresql://qase_control:password@control-db.example.com:5432/qase_control
# QASE_CONTROL_MIGRATION_DATABASE_URL=postgresql://qase_control_migrator:password@control-db.example.com:5432/qase_control
QASE_CONTROL_DATABASE_SSL=require
QASE_CONTROL_DATABASE_POOL_MIN=0
QASE_CONTROL_DATABASE_POOL_MAX=20
# Production defaults false; run `npm run control:db:migrate` separately.
QASE_CONTROL_DATABASE_MIGRATE_ON_START=false
QASE_CONTROL_HOST=127.0.0.1
QASE_CONTROL_PORT=5180
QASE_CONTROL_CELL_STALE_SECONDS=90
# Separate random values of at least 32 bytes, supplied only to trusted services.
# QASE_CONTROL_API_READ_TOKEN=replace-with-a-long-random-read-token
# QASE_CONTROL_API_WRITE_TOKEN=replace-with-a-different-long-random-write-token
QASE_CONTROL_TRUST_PROXY=false

# ── Cell deployment controller (Phase 7, trusted infrastructure only) ──
# Stable cell identity and public origin. The write token belongs only in this
# controller process, never in API/worker/browser-facing configuration.
# QASE_CELL_ID=4a7f5cf0-813d-4e3c-8d5d-4b4b9fc88c10
# QASE_CELL_NAME=qase-ap-south-1
# QASE_CELL_REGION=ap-south-1
# QASE_CELL_PUBLIC_URL=https://qase.example.com
# QASE_CELL_CAPACITY_WEIGHT=100
# QASE_CONTROL_URL=https://control.internal.example.com
# QASE_CELL_METRICS_URL=https://qase-metrics.internal.example.com/metrics
QASE_CELL_HEARTBEAT_INTERVAL_MS=30000
QASE_CELL_HEARTBEAT_TIMEOUT_MS=5000
QASE_CELL_HEARTBEAT_PROBE_HOST=127.0.0.1
QASE_CELL_HEARTBEAT_PROBE_PORT=9175

# Read-only deployment checks. QASE_SMOKE_TARGETS is a comma-separated list of
# name=/healthz or /readyz URLs. The placement load probe is capped in code.
# QASE_SMOKE_TARGETS=api=https://qase.example.com/readyz,control=https://control.internal.example.com/readyz
QASE_CHECK_TIMEOUT_MS=5000
# QASE_LOAD_CONTROL_URL=https://control.internal.example.com
# QASE_LOAD_ORGANIZATION_ID=4a7f5cf0-813d-4e3c-8d5d-4b4b9fc88c01
# QASE_LOAD_PROJECT_ID=4a7f5cf0-813d-4e3c-8d5d-4b4b9fc88c02
QASE_LOAD_REQUESTS=1000
QASE_LOAD_CONCURRENCY=20
# Repeated read-only readiness gate for a reviewed release/canary.
# QASE_RELEASE_ID=sha256:reviewed-image-digest
QASE_RELEASE_ATTEMPTS=3
QASE_RELEASE_INTERVAL_MS=1000
QASE_RELEASE_MAX_READY_P95_MS=2000

# ── Capacity qualification (Phase 9, approved staging only) ─────────
# The k6 workload will not start without the exact acknowledgement and hostname
# allowlist. Use a dedicated test placement and read-only control token.
# QASE_CAPACITY_ACK=I_OWN_THIS_STAGING_TARGET
# QASE_CAPACITY_CONTROL_URL=https://control.staging.example.com
# QASE_CAPACITY_ALLOWED_HOSTS=control.staging.example.com
# QASE_CAPACITY_ORGANIZATION_ID=4a7f5cf0-813d-4e3c-8d5d-4b4b9fc88c11
# QASE_CAPACITY_PROJECT_ID=4a7f5cf0-813d-4e3c-8d5d-4b4b9fc88c12
# QASE_CAPACITY_TARGET_ALIAS=control-staging-a
QASE_CAPACITY_RATE_MULTIPLIER=1
QASE_CAPACITY_EVIDENCE_FILE=capacity-evidence.json

# The current local owner is mapped to one trusted bootstrap organization,
# owner identity and default project. Override UUIDs only with stable values.
# QASE_BOOTSTRAP_ORGANIZATION_ID=4a7f5cf0-813d-4e3c-8d5d-4b4b9fc88c01
# QASE_BOOTSTRAP_ORGANIZATION_SLUG=qase-local
# QASE_BOOTSTRAP_ORGANIZATION_NAME=Qase Local
# QASE_BOOTSTRAP_PROJECT_ID=4a7f5cf0-813d-4e3c-8d5d-4b4b9fc88c02
# QASE_BOOTSTRAP_PROJECT_SLUG=default-project
# QASE_BOOTSTRAP_PROJECT_NAME=Default Project
# QASE_BOOTSTRAP_USER_ID=4a7f5cf0-813d-4e3c-8d5d-4b4b9fc88c03
# QASE_BOOTSTRAP_USER_EMAIL=owner@local.qase.invalid
# QASE_BOOTSTRAP_USER_NAME=Qase Local Owner

# The deliberately broken /demo practice site is enabled outside production.
# Set false to disable it locally. NODE_ENV=production always disables it.
QASE_ENABLE_DEMO=true

# ── Owner authentication ─────────────────────────────────────────────
# local keeps the existing single-owner password flow. drytis enables signed
# launch SSO and requires PostgreSQL plus every QASE_DRYTIS_* setting below.
QASE_AUTH_MODE=local

# Required only for QASE_AUTH_MODE=drytis. All URLs must use HTTPS.
# QASE_PUBLIC_URL=https://qase.example.com
# QASE_DRYTIS_LOGIN_URL=https://studio.drytis.ai/integrations/qase/launch
# QASE_DRYTIS_ISSUER=https://identity.drytis.ai
# QASE_DRYTIS_AUDIENCE=qase-production
# QASE_DRYTIS_JWKS_URL=https://identity.drytis.ai/.well-known/jwks.json

# First launch asks you to create the one owner account. The password is stored
# only as a salted scrypt hash in private OS app data; no default password ships.

# Lifetime of a normal browser session and a "Remember me" session.
QASE_AUTH_SESSION_HOURS=12
QASE_AUTH_REMEMBER_DAYS=30

# auto adds Secure when Qase receives HTTPS directly. Use true behind HTTPS and
# set QASE_TRUST_PROXY=true when exactly one trusted reverse proxy terminates TLS.
QASE_AUTH_COOKIE_SECURE=auto
QASE_TRUST_PROXY=false

# Required to create the first owner account from a non-loopback address.
# Generate a long random value, use it once in the setup screen, then remove it.
# QASE_AUTH_SETUP_TOKEN=replace-with-a-long-random-token

# Auth state defaults to the current user's private OS app-data directory.
# Override only when the destination is private to the server account.
# QASE_AUTH_FILE=C:\private\qase\auth.json
