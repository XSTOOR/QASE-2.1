{
  "name": "qase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Qase — an autonomous QA agent that tests live websites in a real browser, built on @cleanslate/sdk.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "start:jev": "node scripts/start-jev-local.mjs",
    "start:local": "node scripts/start-local.mjs",
    "dev": "node --watch server/index.js",
    "worker": "node server/worker.js",
    "control-plane": "node server/controlPlane/index.js",
    "cell-heartbeat": "node server/cellHeartbeatController.js",
    "test": "node --test --test-concurrency=2 server/*.test.js server/postgres/*.test.js server/controlPlane/*.test.js public/*.test.js",
    "validate:matrix": "node scripts/validate-matrix.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "control:db:migrate": "node scripts/migrate-control-plane.mjs",
    "db:import": "node scripts/import-sessions.mjs",
    "data:governance": "node scripts/data-governance.mjs",
    "prune:local": "node scripts/prune-local.mjs",
    "deployment:smoke": "node scripts/smoke-deployment.mjs",
    "deployment:load": "node scripts/load-placement.mjs",
    "deployment:release-gate": "node scripts/release-gate.mjs",
    "capacity:evaluate": "node scripts/evaluate-capacity.mjs",
    "verify": "node scripts/verify.mjs",
    "release:manifest": "node scripts/write-source-manifest.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "test:production-image": "node scripts/smoke-production-image.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:dashboard": "node scripts/qualify-dashboard.mjs",
    "test:studio-demo": "node scripts/qualify-studio-demo.mjs",
    "qualify:agent": "node scripts/qualify-agent.mjs",
    "qualify:hybrid-gateway": "node scripts/qualify-hybrid-gateway.mjs",
    "qualify:hybrid-startup": "node scripts/qualify-hybrid-startup.mjs",
    "qualify:hybrid-depth": "node scripts/qualify-hybrid-depth.mjs",
    "benchmark:hybrid": "node scripts/benchmark-hybrid-qa.mjs",
    "test:hybrid": "node --test --test-concurrency=2 server/hybrid*.test.js public/hybridQaView.test.js",
    "test:hybrid-launcher": "node scripts/qualify-hybrid-launcher.mjs",
    "install-browser": "playwright install chromium firefox webkit",
    "package": "node scripts/package.mjs",
    "test:auth": "node scripts/test-auth-browser.mjs",
    "test:reset": "node scripts/test-reset-browser.mjs",
    "test:ui": "node scripts/test-ui-responsive.mjs",
    "test:acceptance": "node scripts/test-acceptance.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@cleanslate/sdk": "^0.1.0",
    "compression": "^1.8.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemailer": "^10.0.16",
    "pg": "^8.22.0",
    "playwright": "1.62.0",
    "redis": "6.2.0"
  }
}
